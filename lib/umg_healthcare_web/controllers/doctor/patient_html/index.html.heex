<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Pacientes
    <:subtitle>Selecciona un paciente para ver su expediente y recetarle.</:subtitle>
  </.header>

  <%!-- Plain input: <.input> adds label spacing that misaligns a one-line search bar --%>
  <form
    action={~p"/doctor/patients"}
    method="get"
    id="patient-search"
    class="max-w-md mb-6 flex items-center gap-2"
  >
    <input
      type="search"
      name="q"
      id="patient-search-q"
      value={@query}
      placeholder="Buscar por nombre"
      class="input flex-1"
    />
    <.button>Buscar</.button>
  </form>

  <p :if={@patients == []} class="opacity-70">No hay pacientes que coincidan.</p>

  <.table :if={@patients != []} id="patients" rows={@patients}>
    <:col :let={patient} label="Nombre">{patient.user.full_name}</:col>
    <:col :let={patient} label="Correo">{patient.user.email}</:col>
    <:col :let={patient} label="Teléfono">{patient.phone}</:col>
    <:action :let={patient}>
      <.link href={~p"/doctor/patients/#{patient.id}"}>Ver expediente</.link>
    </:action>
  </.table>
</Layouts.app>
