<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {@record.user.full_name}
    <:subtitle>
      {@record.user.email}
      <span :if={@record.birth_date}>· Nació el {format_date(@record.birth_date)}</span>
      <span :if={@record.phone}>· Tel. {@record.phone}</span>
    </:subtitle>
    <:actions>
      <.button href={~p"/doctor/patients"}>Volver</.button>
      <.button variant="primary" href={~p"/doctor/patients/#{@patient.id}/prescriptions/new"}>
        <.icon name="hero-plus" class="size-4" /> Nueva receta
      </.button>
    </:actions>
  </.header>

  <div class="grid gap-6 lg:grid-cols-2">
    <.panel title="Alergias" id="allergies">
      <p :if={@record.allergies == []} class="mb-4 text-sm text-base-content/60">
        Sin alergias registradas.
      </p>
      <ul :if={@record.allergies != []} class="mb-4 divide-y divide-base-300">
        <li :for={allergy <- @record.allergies} class="flex items-center gap-2 py-2">
          <strong>{allergy.substance}</strong>
          <span class={[
            "badge badge-sm",
            allergy.severity == :severe && "badge-error",
            allergy.severity == :moderate && "badge-warning",
            allergy.severity == :mild && "badge-ghost"
          ]}>
            {severity_label(allergy.severity)}
          </span>
          <span :if={allergy.reaction} class="text-sm text-base-content/60">
            {allergy.reaction}
          </span>
          <.link
            href={~p"/doctor/patients/#{@patient.id}/allergies/#{allergy.id}"}
            method="delete"
            data-confirm="¿Quitar esta alergia?"
            class="ml-auto text-sm text-error hover:underline"
          >
            Quitar
          </.link>
        </li>
      </ul>

      <.form
        for={@allergy_form}
        action={~p"/doctor/patients/#{@patient.id}/allergies"}
        id="allergy-form"
        class="grid gap-x-3 sm:grid-cols-2"
      >
        <.input field={@allergy_form[:substance]} type="text" label="Sustancia" />
        <.input field={@allergy_form[:reaction]} type="text" label="Reacción" />
        <.input
          field={@allergy_form[:severity]}
          type="select"
          label="Gravedad"
          options={[{"Leve", "mild"}, {"Moderada", "moderate"}, {"Grave", "severe"}]}
        />
        <div class="flex items-end pb-2">
          <.button variant="primary" class="btn btn-primary w-full">Agregar alergia</.button>
        </div>
      </.form>
    </.panel>

    <.panel title="Agregar al historial clínico" id="new-record">
      <.form
        for={@record_form}
        action={~p"/doctor/patients/#{@patient.id}/medical_records"}
        id="record-form"
        class="grid gap-x-3 sm:grid-cols-2"
      >
        <.input
          field={@record_form[:kind]}
          type="select"
          label="Tipo"
          options={[
            {"Consulta", "consultation"},
            {"Diagnóstico", "diagnosis"},
            {"Resultado de prueba", "test_result"}
          ]}
        />
        <.input field={@record_form[:recorded_on]} type="date" label="Fecha" />
        <div class="sm:col-span-2">
          <.input field={@record_form[:title]} type="text" label="Título" />
          <.input field={@record_form[:details]} type="textarea" label="Detalle" />
        </div>
        <div class="sm:col-span-2">
          <.button variant="primary">Agregar registro</.button>
        </div>
      </.form>
    </.panel>
  </div>

  <.panel title="Medicaciones actuales" id="current" flush>
    <.empty_state :if={@current == []} icon="hero-beaker">Sin medicación activa.</.empty_state>
    <.table :if={@current != []} id="current-prescriptions" rows={@current}>
      <:col :let={p} label="Medicamento">
        <span class="font-medium">{p.medication.name}</span>
      </:col>
      <:col :let={p} label="Dosis">{p.dose}</:col>
      <:col :let={p} label="Tomas">
        {Enum.map_join(p.dose_schedules, ", ", &activity_label/1)}
      </:col>
      <:col :let={p} label="Inicio">{format_date(p.starts_on)}</:col>
      <:col :let={p} label="Fin">{format_date(Prescription.ends_on(p))}</:col>
      <:action :let={p}>
        <.link
          href={~p"/doctor/prescriptions/#{p.id}/complete"}
          method="patch"
          data-confirm="¿Finalizar este tratamiento?"
          class="btn btn-ghost btn-sm"
        >
          Finalizar
        </.link>
      </:action>
    </.table>
  </.panel>

  <.panel title="Historial clínico" id="history" flush>
    <.empty_state :if={@record.medical_records == []} icon="hero-document-text">
      Sin registros.
    </.empty_state>
    <.table
      :if={@record.medical_records != []}
      id="medical-records"
      rows={@record.medical_records}
    >
      <:col :let={r} label="Fecha">{format_date(r.recorded_on)}</:col>
      <:col :let={r} label="Tipo">
        <span class="badge badge-ghost badge-sm">{kind_label(r.kind)}</span>
      </:col>
      <:col :let={r} label="Título"><span class="font-medium">{r.title}</span></:col>
      <:col :let={r} label="Detalle">{r.details}</:col>
      <:col :let={r} label="Médico">{r.doctor && r.doctor.full_name}</:col>
    </.table>
  </.panel>

  <.panel title="Medicaciones pasadas" id="past" flush>
    <.empty_state :if={@past == []} icon="hero-archive-box">
      Sin medicaciones anteriores.
    </.empty_state>
    <.table :if={@past != []} id="past-prescriptions" rows={@past}>
      <:col :let={p} label="Medicamento">{p.medication.name}</:col>
      <:col :let={p} label="Dosis">{p.dose}</:col>
      <:col :let={p} label="Período">
        {format_date(p.starts_on)} al {format_date(Prescription.ends_on(p))}
      </:col>
      <:col :let={p} label="Estado">
        <span class="badge badge-ghost badge-sm">{prescription_status_label(p.status)}</span>
      </:col>
    </.table>
  </.panel>

  <.adherence_summary
    id="adherence"
    title="Cumplimiento (últimos 30 días)"
    summary={@adherence}
    now={@now}
  />
</Layouts.app>
