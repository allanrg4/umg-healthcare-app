<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Nueva receta para {@patient.user.full_name}
    <:subtitle>Cada toma diaria se ancla a una actividad de la rutina del paciente.</:subtitle>
    <:actions>
      <.button href={~p"/doctor/patients/#{@patient.id}"}>Cancelar</.button>
    </:actions>
  </.header>

  <div :if={@activity_options == []} class="alert alert-warning mb-4">
    El paciente aún no ha definido su rutina diaria. Pídele que agregue actividades en "Mi rutina" antes de recetar.
  </div>

  <.form
    for={@form}
    action={~p"/doctor/patients/#{@patient.id}/prescriptions"}
    id="prescription-form"
    class="max-w-xl"
  >
    <.input
      field={@form[:medication_id]}
      type="select"
      label="Medicamento"
      prompt="Elige un medicamento"
      options={@medication_options}
    />
    <.input field={@form[:dose]} type="text" label="Dosis" placeholder="1 tableta" />
    <.input field={@form[:instructions]} type="textarea" label="Indicaciones" />
    <.input field={@form[:starts_on]} type="date" label="Fecha de inicio" />
    <.input field={@form[:duration_days]} type="number" label="Duración (días)" min="1" />

    <h3 class="font-semibold mt-6 mb-1">Tomas diarias</h3>
    <p class="text-sm opacity-70 mb-2">
      Llena solo las filas que necesites (hasta tres tomas al día).
    </p>

    <.inputs_for :let={schedule} field={@form[:dose_schedules]}>
      <div class="grid gap-2 md:grid-cols-2 mb-2">
        <.input
          field={schedule[:activity_id]}
          type="select"
          label="Actividad"
          prompt="Sin usar"
          options={@activity_options}
        />
        <.input field={schedule[:offset_minutes]} type="number" label="Desfase (minutos)" />
      </div>
    </.inputs_for>

    <p :for={error <- @form[:dose_schedules].errors} class="text-error text-sm">
      {translate_error(error)}
    </p>

    <div class="mt-4">
      <.button variant="primary">Guardar receta</.button>
    </div>
  </.form>
</Layouts.app>
