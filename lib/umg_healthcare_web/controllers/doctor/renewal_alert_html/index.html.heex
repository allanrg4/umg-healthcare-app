<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Recetas por renovar
    <:subtitle>
      Tratamientos activos que terminan en 3 días o menos, o que ya vencieron.
    </:subtitle>
  </.header>

  <p :if={@alerts == []} class="opacity-70">No hay recetas por renovar.</p>

  <.table :if={@alerts != []} id="renewal-alerts" rows={@alerts}>
    <:col :let={p} label="Paciente">{p.patient.user.full_name}</:col>
    <:col :let={p} label="Medicamento">{p.medication.name} · {p.dose}</:col>
    <:col :let={p} label="Termina">{format_date(Prescription.ends_on(p))}</:col>
    <:col :let={p} label="Estado">
      {days_label(Date.diff(Prescription.ends_on(p), @today))}
    </:col>
    <:action :let={p}>
      <.link href={~p"/doctor/patients/#{p.patient_id}/prescriptions/new"}>Nueva receta</.link>
    </:action>
    <:action :let={p}>
      <.link
        href={~p"/doctor/alerts/#{p.id}/renew"}
        method="patch"
        data-confirm="¿Marcar esta receta como renovada?"
      >
        Marcar renovada
      </.link>
    </:action>
  </.table>
</Layouts.app>
